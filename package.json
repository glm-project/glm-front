{
  "name": "glmfront",
  "version": "0.0.0",
  "private": true,
  "description": "glmfront",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "application:gestion": "cypress open --e2e --config-file src/test/webapp/application/gestion/cypress-config.ts",
    "application:headless:gestion": "cypress run --headless --config-file src/test/webapp/application/gestion/cypress-config.ts",
    "application:headless:pupitre": "cypress run --headless --config-file src/test/webapp/application/pupitre/cypress-config.ts",
    "application:pupitre": "cypress open --e2e --config-file src/test/webapp/application/pupitre/cypress-config.ts",
    "build": "npm-run-all build:*",
    "build:gestion": "ng run project:build-gestion",
    "build:pupitre": "ng run project:build-pupitre",
    "component:gestion": "cypress open --e2e --config-file src/test/webapp/component/gestion/cypress-config.ts",
    "component:headless:gestion": "cypress run --headless --config-file src/test/webapp/component/gestion/cypress-config.ts",
    "dev:gestion": "ng run project:serve-gestion",
    "dev:pupitre": "ng run project:serve-pupitre",
    "lint": "eslint .",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "serve:cypress:gestion": "ng run project:serve-gestion:cypress",
    "serve:cypress:pupitre": "ng run project:serve-pupitre:cypress",
    "test": "npm run watch:test",
    "test:application": "npm-run-all test:application:headless:*",
    "test:application:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run application:gestion\"",
    "test:application:headless:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run application:headless:gestion\"",
    "test:application:headless:pupitre": "concurrently -k -s first -n pupitre,test \"npm run serve:cypress:pupitre\" \"wait-on http://localhost:9001 && npm run application:headless:pupitre\"",
    "test:application:pupitre": "concurrently -k -s first -n pupitre,test \"npm run serve:cypress:pupitre\" \"wait-on http://localhost:9001 && npm run application:pupitre\"",
    "test:component": "npm-run-all test:component:headless:*",
    "test:component:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run component:gestion\"",
    "test:component:headless:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run component:headless:gestion\"",
    "test:coverage": "ng test --coverage",
    "watch": "npm-run-all --parallel watch:ng:* watch:test watch:tsc",
    "watch:ng:gestion": "ng run project:build-gestion:development --watch",
    "watch:ng:pupitre": "ng run project:build-pupitre:development --watch",
    "watch:test": "ng test --watch",
    "watch:tsc": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "arch-unit-ts": "1.0.12",
    "keycloak-js": "26.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@eslint/js": "9.39.4",
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/postcss": "4.3.2",
    "@tsconfig/recommended": "1.0.13",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-istanbul": "4.1.9",
    "angular-eslint": "21.4.0",
    "chevrotain": "11.0.3",
    "concurrently": "10.0.4",
    "cypress": "15.18.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.18",
    "prettier": "3.9.4",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.0.10"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24"
  }
}
