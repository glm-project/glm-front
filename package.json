{
  "name": "glmfront",
  "version": "0.0.0",
  "private": true,
  "description": "glmfront",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:backoffice": "ng run project:build-backoffice",
    "component:backoffice": "cypress open --e2e --config-file src/test/webapp/component/backoffice/cypress-config.ts",
    "component:headless": "npm-run-all component:headless:*",
    "component:headless:backoffice": "cypress run --headless --config-file src/test/webapp/component/backoffice/cypress-config.ts",
    "dev": "npm-run-all --parallel dev:*",
    "dev:backoffice": "ng run project:serve-backoffice",
    "e2e:backoffice": "cypress open --e2e --config-file src/test/webapp/e2e/backoffice/cypress-config.ts",
    "e2e:headless": "npm-run-all e2e:headless:*",
    "e2e:headless:backoffice": "cypress run --headless --config-file src/test/webapp/e2e/backoffice/cypress-config.ts",
    "lint": "eslint .",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "serve:e2e": "npm-run-all --parallel serve:e2e:*",
    "serve:e2e:backoffice": "ng run project:serve-backoffice:e2e",
    "start": "npm run dev",
    "test": "npm run watch:test",
    "test:component:backoffice": "concurrently -k -s first -n backoffice,test \"npm run serve:e2e:backoffice\" \"wait-on http://localhost:9000 && npm run component:backoffice\"",
    "test:component:headless": "concurrently -k -s first -n backoffice,test \"npm run serve:e2e:backoffice\" \"wait-on http://localhost:9000 && npm run component:headless\"",
    "test:coverage": "ng test --coverage",
    "test:e2e:headless": "concurrently -k -s first -n backoffice,test \"npm run serve:e2e:backoffice\" \"wait-on http://localhost:9000 && npm run e2e:headless\"",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ng": "npm-run-all --parallel watch:ng:*",
    "watch:ng:backoffice": "ng run project:build-backoffice:development --watch",
    "watch:test": "ng test --watch",
    "watch:tsc": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "arch-unit-ts": "1.0.12",
    "keycloak-js": "26.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@eslint/js": "9.39.4",
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/postcss": "4.3.2",
    "@tsconfig/recommended": "1.0.13",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-istanbul": "4.1.9",
    "angular-eslint": "21.4.0",
    "chevrotain": "11.0.3",
    "concurrently": "10.0.4",
    "cypress": "15.18.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.18",
    "prettier": "3.9.4",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.0.10"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24"
  }
}
