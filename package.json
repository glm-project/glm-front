{
  "name": "glmfront",
  "version": "0.0.0",
  "private": true,
  "description": "glmfront",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-api-contract.mjs",
    "application:gestion": "cypress open --e2e --config-file src/test/webapp/application/gestion/cypress-config.ts",
    "application:headless:gestion": "cypress run --headless --config-file src/test/webapp/application/gestion/cypress-config.ts",
    "application:headless:pupitre": "cypress run --headless --config-file src/test/webapp/application/pupitre/cypress-config.ts",
    "application:pupitre": "cypress open --e2e --config-file src/test/webapp/application/pupitre/cypress-config.ts",
    "build": "npm-run-all build:*",
    "build:gestion": "ng run project:build-gestion",
    "build:pupitre": "ng run project:build-pupitre",
    "component:gestion": "cypress open --e2e --config-file src/test/webapp/component/gestion/cypress-config.ts",
    "component:headless:gestion": "cypress run --headless --config-file src/test/webapp/component/gestion/cypress-config.ts",
    "component:headless:pupitre": "cypress run --headless --config-file src/test/webapp/component/pupitre/cypress-config.ts",
    "dev:gestion": "ng run project:serve-gestion",
    "dev:pupitre": "ng run project:serve-pupitre",
    "lint": "npm run test:documentation && npm run test:reproducibility && node --test eslint/rules/*.spec.mjs && eslint .",
    "measure": "node scripts/measure-command.mjs",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "production-offline:build:pupitre": "npm run build:pupitre && ng run project:build-pupitre:production,production-offline-fixture",
    "production-offline:headless:no-service-worker": "PUPITRE_OFFLINE_MODE=no-service-worker cypress run --headless --browser chrome --config-file src/test/webapp/application/pupitre/production-offline/cypress-config.ts",
    "production-offline:headless:service-worker": "PUPITRE_OFFLINE_MODE=service-worker cypress run --headless --browser chrome --config-file src/test/webapp/application/pupitre/production-offline/cypress-config.ts",
    "runtime:check": "node scripts/check-runtime.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "security:secrets:history": "node scripts/scan-secrets.mjs history",
    "security:secrets:staged": "node scripts/scan-secrets.mjs staged",
    "security:workflows": "actionlint -no-color",
    "serve:cypress:component:pupitre": "ng run project:serve-pupitre:component-cypress",
    "serve:cypress:gestion": "ng run project:serve-gestion:cypress",
    "serve:cypress:pupitre": "ng run project:serve-pupitre:cypress",
    "serve:production-offline:no-service-worker": "node scripts/serve-production-pupitre-fixture.mjs --port=9011 --service-worker=disabled",
    "serve:production-offline:service-worker": "node scripts/serve-production-pupitre-fixture.mjs --port=9010 --service-worker=enabled",
    "test": "npm run watch:test",
    "test:application": "npm-run-all test:application:headless:*",
    "test:application:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run application:gestion\"",
    "test:application:headless:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run application:headless:gestion\"",
    "test:application:headless:pupitre": "concurrently -k -s first -n pupitre,test \"npm run serve:cypress:pupitre\" \"wait-on http://localhost:9001 && npm run application:headless:pupitre\"",
    "test:application:pupitre": "concurrently -k -s first -n pupitre,test \"npm run serve:cypress:pupitre\" \"wait-on http://localhost:9001 && npm run application:pupitre\"",
    "test:browser": "npm-run-all test:component test:application",
    "test:component": "npm-run-all test:component:headless:*",
    "test:component:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run component:gestion\"",
    "test:component:headless:gestion": "concurrently -k -s first -n gestion,test \"npm run serve:cypress:gestion\" \"wait-on http://localhost:9000 && npm run component:headless:gestion\"",
    "test:component:headless:pupitre": "concurrently -k -s first -n pupitre,test \"npm run serve:cypress:component:pupitre\" \"wait-on http://localhost:9001 && npm run component:headless:pupitre\"",
    "test:coverage": "ng test --coverage",
    "test:coverage:ci": "npm run test:coverage -- --watch=false",
    "test:documentation": "node --test documentation/documentation.spec.mjs",
    "test:mutation:replay": "stryker run",
    "test:production-offline": "npm-run-all production-offline:build:pupitre test:production-offline:no-service-worker test:production-offline:service-worker",
    "test:production-offline:no-service-worker": "concurrently -k -s first -n server,test \"npm run serve:production-offline:no-service-worker\" \"wait-on http://localhost:9011/__harness && PUPITRE_OFFLINE_BASE_URL=http://localhost:9011 npm run production-offline:headless:no-service-worker\"",
    "test:production-offline:service-worker": "concurrently -k -s first -n server,test \"npm run serve:production-offline:service-worker\" \"wait-on http://localhost:9010/__harness && PUPITRE_OFFLINE_BASE_URL=http://localhost:9010 npm run production-offline:headless:service-worker\"",
    "test:reproducibility": "node --test scripts/generate-api-contract.spec.mjs",
    "test:security": "node --test scripts/audit-dependencies.spec.mjs scripts/codex-stop-validation.spec.mjs scripts/security-controls.spec.mjs",
    "test:typecheck": "node --test typescript/*.spec.mjs",
    "typecheck": "npm-run-all types:* test:typecheck",
    "typecheck:watch": "npm-run-all --parallel watch:types:*",
    "types:application": "tsc --noEmit --project src/test/webapp/application/tsconfig.json",
    "types:component": "tsc --noEmit --project src/test/webapp/component/tsconfig.json",
    "types:production": "tsc --noEmit --project tsconfig.app.json",
    "types:unit": "tsc --noEmit --project tsconfig.spec.json",
    "types:utils": "tsc --noEmit --project src/test/webapp/utils/tsconfig.json",
    "validate:application": "npm-run-all api:generate test:application",
    "validate:checks-and-unit": "npm-run-all validate:quick test:coverage:ci",
    "validate:commit": "npm-run-all security:secrets:staged validate:staged",
    "validate:complete": "npm-run-all validate:quick validate:security:reports test:coverage:ci build test:browser validate:production-offline",
    "validate:component": "npm-run-all api:generate test:component",
    "validate:production-build": "npm-run-all api:generate build",
    "validate:production-offline": "npm-run-all api:generate test:production-offline",
    "validate:quick": "npm-run-all runtime:check api:generate validate:static",
    "validate:security": "npm-run-all security:workflows validate:security:reports",
    "validate:security:reports": "npm-run-all test:security security:secrets:history security:audit",
    "validate:staged": "lint-staged",
    "validate:static": "npm-run-all --parallel lint prettier:check typecheck security:workflows",
    "watch": "npm-run-all --parallel watch:ng:* watch:test watch:tsc",
    "watch:ng:gestion": "ng run project:build-gestion:development --watch",
    "watch:ng:pupitre": "ng run project:build-pupitre:development --watch",
    "watch:test": "ng test --watch",
    "watch:tsc": "npm run typecheck:watch",
    "watch:types:application": "npm run types:application -- --watch",
    "watch:types:component": "npm run types:component -- --watch",
    "watch:types:production": "npm run types:production -- --watch",
    "watch:types:unit": "npm run types:unit -- --watch",
    "watch:types:utils": "npm run types:utils -- --watch"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@angular/service-worker": "21.2.19",
    "@ng-icons/core": "34.0.0",
    "@ng-icons/lucide": "34.0.0",
    "arch-unit-ts": "1.0.12",
    "keycloak-js": "26.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@eslint/js": "9.39.4",
    "@prettier/plugin-xml": "3.4.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@tailwindcss/postcss": "4.3.2",
    "@tsconfig/recommended": "1.0.13",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-istanbul": "4.1.9",
    "angular-eslint": "21.4.0",
    "concurrently": "10.0.4",
    "cypress": "15.18.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.3",
    "eslint-plugin-sonarjs": "4.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "npm-run-all2": "9.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "prettier": "3.9.4",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.10.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.0.10"
  },
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.18.0"
  }
}
