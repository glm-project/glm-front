{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "target/out-tsc/spec",
    "isolatedModules": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/main/webapp/**/*.spec.ts",
    "src/main/webapp/**/*.d.ts",
    "src/main/webapp/**/package-info.ts",
    "src/test/webapp/unit/**/*.spec.ts"
  ]
}
