{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "project": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build-backoffice": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "target/classes/static/backoffice",
              "browser": ""
            },
            "index": "src/main/webapp/backoffice/index.html",
            "browser": "src/main/webapp/backoffice/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/main/webapp/content",
              {
                "glob": "**/*",
                "input": "src/main/webapp/content",
                "output": "content"
              }
            ],
            "styles": ["src/main/webapp/styles.css", "@angular/material/prebuilt-themes/indigo-pink.css"],
            "scripts": [],
            "allowedCommonJsDependencies": ["base64-js", "js-sha256", "keycloak-js"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/main/webapp/backoffice/environments/environment.ts",
                  "with": "src/main/webapp/backoffice/environments/environment.local.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/main/webapp/backoffice/environments/environment.ts",
                  "with": "src/main/webapp/backoffice/environments/environment.local.ts"
                },
                {
                  "replace": "src/main/webapp/backoffice/keycloak.provider.ts",
                  "with": "src/main/webapp/backoffice/keycloak.provider.e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-backoffice": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 9000,
            "buildTarget": "project:build-backoffice",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "project:build-backoffice:production"
            },
            "development": {
              "buildTarget": "project:build-backoffice:development"
            },
            "e2e": {
              "buildTarget": "project:build-backoffice:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "build-pupitre": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "target/classes/static/pupitre",
              "browser": ""
            },
            "index": "src/main/webapp/pupitre/index.html",
            "browser": "src/main/webapp/pupitre/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/main/webapp/styles.css", "@angular/material/prebuilt-themes/indigo-pink.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/main/webapp/pupitre/environments/environment.ts",
                  "with": "src/main/webapp/pupitre/environments/environment.local.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "src/main/webapp/pupitre/environments/environment.ts",
                  "with": "src/main/webapp/pupitre/environments/environment.local.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-pupitre": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 9001,
            "buildTarget": "project:build-pupitre",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "project:build-pupitre:production"
            },
            "development": {
              "buildTarget": "project:build-pupitre:development"
            },
            "e2e": {
              "buildTarget": "project:build-pupitre:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "project:build-backoffice:development",
            "runnerConfig": "vitest.config.ts",
            "exclude": ["**/webapp/{e2e,component}/**"],
            "coverageInclude": ["src/main/webapp/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/main.ts", "**/environments/**", "**/*.provider*.ts", "**/package-info.ts"]
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "project:build-backoffice"
          }
        }
      }
    }
  }
}
